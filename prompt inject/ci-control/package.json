{
  "name": "ci-control",
  "version": "0.1.0",
  "description": "注入频次选择器（静态版）：为「锚定标准（上下文注入）」预设提供对话工具行 UI，读写 $DSH_HOME/.context-injector.json 控制 context-injector 的注入频次（每轮/隔一轮/隔两轮/隔三轮/关闭）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "platform": "web",
      "inject": [
        "@deepseek-ai/dsh-client-runtime",
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-api-gateway"
      ]
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "scripts": {
    "check": "node --check lib/index.js && node --check lib/client.js"
  },
  "dependencies": {
    "@deepseek-ai/dsh-typert-protocol": "^0.1.0-rc.6",
    "zod": "^4.0.0"
  },
  "files": [
    "lib",
    "cordis.patch.yml"
  ],
  "license": "MIT"
}
